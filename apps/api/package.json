{
  "name": "@gd/api",
  "version": "0.0.0",
  "private": true,
  "description": "HTTP API (Fastify). Read-only health endpoint for now; no database, auth, CORS or public writes yet.",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@gd/domain": "workspace:*",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
