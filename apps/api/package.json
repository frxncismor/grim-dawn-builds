{
  "name": "@gd/api",
  "version": "0.0.0",
  "private": true,
  "description": "HTTP API (Fastify). Read-only health endpoint for now; no database, auth, CORS or public writes yet.",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "typecheck": "pnpm --filter @gd/domain build && tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "build": "pnpm --filter @gd/domain build && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "@gd/domain": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fastify": "^5.12.8",
    "pg": "8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
