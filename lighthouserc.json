{
  "ci": {
    "collect": {
      "staticDistDir": "./dist/grim-dawn-builds/browser",
      "url": [
        "http://localhost/index.html",
        "http://localhost/tier-list/index.html",
        "http://localhost/acerca/index.html",
        "http://localhost/legal/index.html",
        "http://localhost/autores/grim-dawn-builds/index.html",
        "http://localhost/es/index.html",
        "http://localhost/es/tier-list/index.html"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 412,
          "height": 823,
          "deviceScaleFactor": 1.75,
          "disabled": false
        },
        "throttlingMethod": "simulate",
        "throttling": {
          "rttMs": 150,
          "throughputKbps": 1638.4,
          "cpuSlowdownMultiplier": 4,
          "requestLatencyMs": 562.5,
          "downloadThroughputKbps": 1474.56,
          "uploadThroughputKbps": 675
        }
      }
    },
    "assert": {
      "assertOptions": {
        "includePassedAssertions": false
      },
      "assertions": {
        "largest-contentful-paint": ["error", { "maxNumericValue": 2000 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
        "total-blocking-time": ["error", { "maxNumericValue": 150 }],
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./dist/lighthouse-performance"
    }
  }
}
