{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false,
    "schematicCollections": ["angular-eslint"]
  },
  "newProjectRoot": "projects",
  "projects": {
    "grim-dawn-builds": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "*.svg",
                "input": "src/assets/icons",
                "output": "assets/icons"
              }
            ],
            "styles": ["src/styles.css"],
            "server": "src/main.server.ts",
            "outputMode": "static",
            "security": {
              "allowedHosts": []
            },
            "polyfills": ["@angular/localize/init"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "280kB",
                  "maximumError": "300kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "statsJson": true
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "tier-preview": {
              "browser": "src/app/features/tier-list/tier-preview.browser.ts",
              "server": "src/app/features/tier-list/tier-preview.server.ts",
              "outputPath": "dist/tier-preview",
              "optimization": true,
              "outputHashing": "all",
              "statsJson": true
            },
            "skill-tree-preview": {
              "browser": "src/app/shared/svg/skill-tree/preview.browser.ts",
              "server": "src/app/shared/svg/skill-tree/preview.server.ts",
              "outputPath": "dist/skill-tree-preview",
              "optimization": true,
              "outputHashing": "all",
              "statsJson": true
            },
            "devotion-map-preview": {
              "browser": "src/app/shared/svg/devotion-map/preview.browser.ts",
              "server": "src/app/shared/svg/devotion-map/preview.server.ts",
              "outputPath": "dist/devotion-map-preview",
              "optimization": true,
              "outputHashing": "all",
              "statsJson": true
            },
            "purchase-stepper-preview": {
              "browser": "src/app/features/build/purchase-stepper/preview.browser.ts",
              "server": "src/app/features/build/purchase-stepper/preview.server.ts",
              "outputPath": "dist/purchase-stepper-preview",
              "optimization": true,
              "outputHashing": "all",
              "statsJson": true
            },
            "devotion-section-preview": {
              "browser": "src/app/features/build/devotion-section/preview.browser.ts",
              "server": "src/app/features/build/devotion-section/preview.server.ts",
              "outputPath": "dist/devotion-section-preview",
              "optimization": true,
              "outputHashing": "all",
              "statsJson": true
            },
            "loot-filter-preview": {
              "browser": "src/app/features/build/loot-filter/preview.browser.ts",
              "server": "src/app/features/build/loot-filter/preview.server.ts",
              "outputPath": "dist/loot-filter-preview",
              "optimization": true,
              "outputHashing": "all",
              "statsJson": true,
              "budgets": [
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ]
            },
            "video-facade-preview": {
              "browser": "src/app/features/build/video-facade/preview.browser.ts",
              "server": "src/app/features/build/video-facade/preview.server.ts",
              "outputPath": "dist/video-facade-preview",
              "optimization": true,
              "outputHashing": "all",
              "statsJson": true,
              "budgets": [
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ]
            },
            "build-sections-preview": {
              "browser": "src/app/features/build/sections/preview.browser.ts",
              "server": "src/app/features/build/sections/preview.server.ts",
              "outputPath": "dist/build-sections-preview",
              "optimization": true,
              "outputHashing": "all",
              "statsJson": true
            },
            "icon-preview": {
              "browser": "src/app/shared/ui/icon/preview.browser.ts",
              "server": "src/app/shared/ui/icon/preview.server.ts",
              "outputPath": "dist/icon-preview",
              "optimization": true,
              "outputHashing": "all",
              "statsJson": true,
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public"
                },
                {
                  "glob": "*.svg",
                  "input": "src/assets/icons",
                  "output": "assets/icons"
                },
                {
                  "glob": "approved-preview.svg",
                  "input": "src/app/shared/ui/icon/fixtures",
                  "output": "assets/official"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "grim-dawn-builds:build:production"
            },
            "development": {
              "buildTarget": "grim-dawn-builds:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["src/**/*.ts", "src/**/*.html"]
          }
        }
      }
    }
  }
}
