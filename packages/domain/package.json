{
  "name": "@gd/domain",
  "version": "0.0.0",
  "private": true,
  "description": "Pure content rules shared by web, api and scripts: Zod schemas, vocabulary, publication and asset rules. No framework, HTTP or I/O.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./vocabulary": {
      "types": "./dist/src/vocabulary.d.ts",
      "default": "./dist/src/vocabulary.js"
    },
    "./testing": {
      "types": "./dist/testing/repository-contract.d.ts",
      "default": "./dist/testing/repository-contract.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "pnpm run build && vitest run --coverage",
    "test:properties": "vitest run property --reporter=verbose",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@vitest/coverage-v8": "4.1.12",
    "fast-check": "4.10.2",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
