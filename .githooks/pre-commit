#!/bin/sh
# pre-commit (T-083): escanea con gitleaks los cambios en staging antes de cada commit.
# Activación por clon: `pnpm setup:hooks` (git config core.hooksPath .githooks).
# Fallo cerrado: sin gitleaks instalado el commit se bloquea con instrucciones.
# La CI repite el escaneo sobre el rango de commits de cada PR y el historial se escanea
# periódicamente; este hook no sustituye a esas comprobaciones.
set -eu

repo_root=$(git rev-parse --show-toplevel)
native=gitleaks
if [ "${OS:-}" = "Windows_NT" ]; then
  native=gitleaks.exe
fi
gitleaks_tool="$repo_root/.tools/gitleaks/8.30.1/$native"
if [ -L "$gitleaks_tool" ]; then
  echo "pre-commit: herramienta local inválida; ejecuta pnpm setup:gitleaks." >&2
  exit 1
fi
if [ -f "$gitleaks_tool" ]; then
  :
elif command -v gitleaks >/dev/null 2>&1; then
  gitleaks_tool=$(command -v gitleaks)
else
  echo "pre-commit: falta gitleaks 8.30.1; ejecuta pnpm setup:gitleaks." >&2
  exit 1
fi
gitleaks_version=$("$gitleaks_tool" version 2>/dev/null) || {
  echo "pre-commit: no se pudo verificar gitleaks; ejecuta pnpm setup:gitleaks." >&2
  exit 1
}
if [ "$gitleaks_version" != "8.30.1" ]; then
  echo "pre-commit: versión de gitleaks inválida; ejecuta pnpm setup:gitleaks." >&2
  exit 1
fi
exec "$gitleaks_tool" git --pre-commit --staged --redact --exit-code 1 --config "$repo_root/.gitleaks.toml" "$repo_root"
