{
  "name": "grim-dawn-builds",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && tsx scripts/static-home.mts && tsx scripts/emit-404.mts && tsx scripts/gen-sitemap.mts && tsx scripts/check-initial-js.mts",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:rotation": "vitest run scripts/rotate-secret.int.spec.mts",
    "test:scripts": "node --import tsx --test scripts/verify-local.test.mjs scripts/lint-md.test.mjs scripts/validate-content.test.mts scripts/check-scope.test.mts scripts/check-boundaries.test.mts scripts/check-secrets.test.mts scripts/check-ci-secrets.test.mts scripts/ci-workflow.test.mts scripts/domain-runtime.test.mts scripts/setup-env.test.mts scripts/secret-scan.test.mts scripts/compose.test.mts scripts/gen-catalog.test.mts scripts/check-contrast.test.mts scripts/check-initial-js.test.mts scripts/rotate-secret.test.mts scripts/seed-content.test.mts src/app/core/content/fixture-source.server.test.mts src/app/core/content/parity.test.mts src/app/core/content/api.repository.server.test.mts src/app/core/content/content-source.server.test.mts scripts/check-release.test.mts scripts/build-release.test.mts scripts/editor-content.test.mts scripts/bootstrap-content.test.mts scripts/check-public-build.test.mts scripts/setup-gitleaks.test.mts src/app/shared/ui/icon/resolve-icon.server.test.mts src/app/core/content/catalog.server.test.mts scripts/static-home.test.mts src/app/core/content/author-pages.server.test.mts scripts/svg-preview.test.mts scripts/emit-404.test.mts scripts/check-performance.test.mts scripts/gen-sitemap.test.mts scripts/check-locale-parity.test.mts scripts/locales.test.mts scripts/herdr-space.test.mts",
    "content:validate": "tsx scripts/validate-content.mts",
    "catalog:generate": "tsx scripts/gen-catalog.mts",
    "catalog:check": "tsx scripts/gen-catalog.mts --check",
    "db:seed": "tsx scripts/seed-content.mts",
    "assets:check": "tsx scripts/check-assets.mts",
    "check:scope": "tsx scripts/check-scope.mts",
    "check:boundaries": "tsx scripts/check-boundaries.mts",
    "check:contrast": "tsx scripts/check-contrast.mts",
    "check:locale-parity": "tsx scripts/check-locale-parity.mts",
    "herdr:space": "tsx scripts/herdr-space.mts",
    "check:initial-js": "tsx scripts/check-initial-js.mts",
    "check:secrets": "tsx scripts/check-secrets.mts",
    "check:ci-secrets": "tsx scripts/check-ci-secrets.mts",
    "setup:hooks": "git config core.hooksPath .githooks",
    "setup:env": "tsx scripts/setup-env.mts",
    "secrets:rotate": "tsx scripts/rotate-secret.mts",
    "verify": "node scripts/verify-local.mjs",
    "lint": "ng lint",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,json}\" \"packages/**/*.{ts,json}\" \"apps/api/src/**/*.ts\" \"apps/api/*.json\" \"*.{js,json,md}\"",
    "format": "prettier --write \"src/**/*.{ts,html,css,json}\" \"packages/**/*.{ts,json}\" \"apps/api/src/**/*.ts\" \"apps/api/*.json\" \"*.{js,json,md}\"",
    "test:api-adapter": "vitest run tests/integration/api-content.int.spec.ts",
    "build:release": "tsx scripts/build-release.mts && tsx scripts/emit-404.mts",
    "check:release": "tsx scripts/check-release.mts",
    "db:edit": "tsx scripts/editor-content.mts",
    "db:bootstrap": "tsx scripts/bootstrap-content.mts",
    "check:public-build": "tsx scripts/check-public-build.mts",
    "check:performance": "tsx scripts/check-performance.mts",
    "sitemap:generate": "tsx scripts/gen-sitemap.mts",
    "setup:gitleaks": "tsx scripts/setup-gitleaks.mts",
    "e2e:svg": "tsx scripts/run-svg-e2e.mts",
    "e2e:a11y": "playwright test --config playwright.config.ts --grep \"@a11y\"",
    "e2e:journeys": "playwright test --config playwright.config.ts --grep \"@journeys\"",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json"
  },
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.29",
    "@gd/domain": "workspace:*",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.29",
    "@angular/cli": "^21.2.29",
    "@angular/compiler-cli": "^21.2.0",
    "@angular/localize": "^21.2.26",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "0.16.0",
    "@playwright/test": "1.65.0",
    "@types/node": "^20.17.19",
    "angular-eslint": "21.4.0",
    "axe-core": "4.14.0",
    "chrome-launcher": "1.2.3",
    "eslint": "^10.3.0",
    "jsdom": "^28.0.0",
    "lighthouse": "13.6.0",
    "markdownlint-cli2": "0.24.0",
    "prettier": "^3.8.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.59.2",
    "vitest": "^4.0.8"
  }
}
