# Public build and preview template (T-045). Only variable names and safe,
# non-secret defaults live here; this file is a reference, not a config Angular
# reads.
#
# These are shell environment variables consumed by `pnpm build` and by the
# local static preview. Angular does not load `.env` files automatically: export
# them in the shell before running the command, for example
# `$env:BASE_URL='http://localhost:4200/'` in PowerShell or
# `export BASE_URL='http://localhost:4200/'` in POSIX shells.
#
# Real secrets never belong here and never appear in any tracked file: they live
# only in git-ignored local files (infra/docker/.env, infra/docker/secrets/).
# Details are in docs/security/secrets.md (constitution XII; plan §13.2).
# The Docker Compose template is separate: infra/docker/.env.example.

# Absolute http(s) URL without credentials, query or fragment. It fixes the
# absolute canonical and Open Graph URLs, sitemap.xml and robots.txt; an invalid
# value fails that generation with a message that does not echo credentials.
BASE_URL=http://localhost:4200/

# `true` or `false` only, and only with CONTENT_SOURCE=fixture. `true` adds the
# local `borrador` guide with the "Borrador · no público" banner and `noindex`.
# Public and release builds force `false`; CONTENT_SOURCE=api rejects it.
INCLUDE_DRAFTS=false

# `fixture` (development, tests, CI without Docker) or `api` (release, public).
# `api` never degrades silently to fixtures.
CONTENT_SOURCE=fixture
