# Local environment template for infra/docker (T-080). Only names and safe,
# non-secret defaults live here. Secret fields stay blank in this file.
# Real values belong only in infra/docker/.env or infra/docker/secrets/, both git-ignored
# (constitution XII; plan §13.2). Never copy a value into this file.

# Application
APP_ENV=development
CONTENT_SOURCE=fixture
API_PORT=3000
CORS_ORIGINS=http://localhost:4200
# Read-only API: body bytes 1024..65536; fixed-window requests/minute/IP 1..10000.
# CORS is restricted to the exact origin above; no wildcard or alternate origin.
API_BODY_LIMIT_BYTES=16384
API_RATE_LIMIT=120

# Database (PostgreSQL 17; not published to the host by default)
POSTGRES_DB=gd_dev
POSTGRES_USER=postgres

# Role names: one login per role, each process receives only its own credential
DB_USER_MIGRATOR=migrator
DB_USER_IMPORTER=importer
DB_USER_EDITOR=editor
DB_USER_API_RO=api_ro

# Secret fields: intentionally empty. Filled locally by the developer (T-079).
POSTGRES_PASSWORD=
DB_PASSWORD_MIGRATOR=
DB_PASSWORD_IMPORTER=
DB_PASSWORD_EDITOR=
DB_PASSWORD_API_RO=
